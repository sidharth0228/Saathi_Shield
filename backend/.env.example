# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-saathi-shield-development-key-123456789
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=saathi_shield
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-saathi-shield-development-key-987654321

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=alerts@saathishield.live

# AWS S3 Evidence Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=saathi-shield-evidence
AWS_S3_REGION_NAME=us-east-1
